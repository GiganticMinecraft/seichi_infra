{
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  timezone: 'Asia/Tokyo',
  reviewers: [
    'outductor',
  ],
  packageRules: [
    {
      // MariaDB サーバのシリーズ (11.8 → 12.3 等) をまたぐ更新は mariadb-upgrade による
      // system table 移行 (updateStrategy.mariadbAutoUpgradeEnabled) とクライアント互換の確認が
      // 必要で、データディレクトリも戻せないため Renovate には同一シリーズ内の patch 更新のみ出させる
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'public.ecr.aws/docker/library/mariadb',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        'go',
      ],
    },
    {
      // mod-downloader は依存更新のたびにイメージが再ビルドされ、全 mcserver の
      // StatefulSet の digest 更新につながるため、Go モジュールの更新は 1 本にまとめる
      matchManagers: [
        'gomod',
      ],
      matchFileNames: [
        'docker-images/mod-downloader/**',
      ],
      groupName: 'mod-downloader go modules',
    },
    {
      matchManagers: [
        'terraform',
      ],
      matchPackageNames: [
        '*',
      ],
      groupName: 'terraform packages',
      enabled: true,
      schedule: [
        'at any time',
      ],
    },
    {
      // chart の patch 更新でも Argo CD 本体の minor 更新を含みうるため、
      // 汎用の Terraform グループから分離して appVersion の確認を促す。
      matchManagers: [
        'terraform',
      ],
      matchPackageNames: [
        'argo-cd',
      ],
      groupName: 'Argo CD',
      prBodyNotes: [
        ':warning: Helm chart のバージョンだけでなく、Chart.yaml の appVersion と Argo CD の upgrade notes を確認してください。',
        ':warning: dex のイメージは chart の既定値 (values.yaml の dex.image.tag) に従うので、dex の版が変わる場合は反映後に GitHub SSO でログインできることを確認してください。',
      ],
    },
    {
      // hubble-observer のイメージ (quay.io/cilium/cilium) を Cilium の chart と同じ PR で上げる
      matchPackageNames: [
        'cilium',
        'quay.io/cilium/cilium',
      ],
      groupName: 'Cilium',
    },
    {
      // synology-csi のサイドカーは上流マニフェストの ClusterRole を kustomize で補っているので、
      // 新しいサイドカーが要求する権限が足りないと provisioning やスナップショットが止まる。
      matchManagers: [
        'kustomize',
      ],
      matchPackageNames: [
        'registry.k8s.io/sig-storage/*',
      ],
      groupName: 'synology-csi sidecars',
      prBodyNotes: [
        ':warning: synology-csi-storageclass/kustomization.yaml の ClusterRole patch が、新しいサイドカーの deploy/kubernetes/rbac.yaml の権限を満たしているか確認してください。',
        ':warning: 各サイドカーのリリースノートで、上流マニフェストが使う引数 (--timeout / --csi-address / --extra-create-metadata / --kubelet-registration-path) と、csi-snapshotter に付けている --feature-gates=CSIVolumeGroupSnapshot=false が引き続き使えるか確認してください。',
      ],
    },
    {
      matchManagers: [
        'dockerfile',
        'kubernetes',
      ],
      matchPackageNames: [
        'ghcr.io/giganticminecraft/seichi_minecraft_server_*',
      ],
      groupName: 'seichi_minecraft_server images',
      enabled: true,
      schedule: [
        'at any time',
      ],
      automerge: true,
      // 07:00～08:00(JST) の間は ArgoCD の自動 Sync が有効になっていることから、
      // この時間帯に自動マージがされると、Sync されてサーバが再起動されてしまうため、その時間帯を避けて自動マージする
      // ref: https://github.com/GiganticMinecraft/seichi_infra/blob/7fb9a41ce385675aed955c42c833caafcbaf387e/seichi-onp-k8s/manifests/seichi-kubernetes/apps/root/projects.yaml#L217-L231
      automergeSchedule: [
        // 00:00-06:59
        '* 0-6 * * *',
        // 08:00-23:59
        '* 8-23 * * *',
      ],
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'itzg/minecraft-server*',
        // build_itzg_images.yaml が Ubuntu 26.04 で再ビルドした上流イメージ (build_mcserver_base_images.yaml から参照)
        'ghcr.io/giganticminecraft/itzg-*',
      ],
      groupName: 'itzg/minecraft-server images',
      schedule: [
        'at any time',
      ],
      automerge: true,
    },
    {
      // itzg/mc-proxy (bungeecord) は tag だけだとノードのキャッシュ次第で古い
      // mc-image-helper が使われ続けるため digest で固定し、再ビルドのたびに
      // 1 本の PR で追従する。seichi-gateway には sync window が無く、マージ即
      // ローリング再起動でプレイヤーが切断されるので automerge はしない
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'itzg/mc-proxy',
      ],
      groupName: 'itzg/mc-proxy image',
      pinDigests: true,
      schedule: [
        'at any time',
      ],
    },
    {
      // build_itzg_images.yaml が再ビルドする上流 (itzg) の Dockerfile のタグ。
      // マージしてもイメージが ghcr に積まれるだけで、本番への反映は下流の digest 更新 PR
      // (seichi_minecraft_server images) で別途行うので automerge する
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'itzg/docker-minecraft-server',
      ],
      groupName: 'itzg upstream image sources',
      schedule: [
        'at any time',
      ],
      automerge: true,
    },
    {
      // 同じく build_itzg_images.yaml の base image。Java 17 系のタグに固定し、
      // Ubuntu / JDK 側の更新は digest で追従する
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'eclipse-temurin',
      ],
      allowedVersions: '/^17(-jre)?$/',
      pinDigests: true,
      groupName: 'itzg upstream image sources',
      schedule: [
        'at any time',
      ],
      automerge: true,
    },
    {
      matchPackageNames: [
        'ghcr.io/mariadb-operator/charts/mariadb-operator',
        'ghcr.io/mariadb-operator/charts/mariadb-operator-crds',
      ],
      groupName: 'mariadb-operator',
    },
    {
      // debianは日付付きタグ（例: trixie-20260406）を無視し、バージョン番号（例: 13, 13.4, 13-slim）・コードネーム（例: trixie, trixie-slim, trixie-backports）・エイリアス（例: stable, latest）のみ許可する
      matchPackageNames: [
        'debian', 'mirror.gcr.io/debian'
      ],
      allowedVersions: '/^(\\d+(\\.\\d+)?(-slim)?|[a-z][a-z-]+(-slim|-backports)?)$/',
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'GiganticMinecraft/OriginalResourcePack',
      ],
      schedule: [
        'at any time',
      ],
      automerge: true,
    },
    {
      // ghcr.io/giganticminecraft/* は Kyverno の verify-ghcr-image-signatures
      // (verifyDigest: true) の検証対象であり、tag のみの参照は
      // "missing digest" の PolicyViolation になる。Audit モードでは
      // mutateDigest: true を設定できないため、Git 側で digest をピン留めする
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/giganticminecraft/**',
      ],
      pinDigests: true,
    },
    {
      // 同じリポジトリのコミットからビルドされる組は 1 つの PR でまとめて更新する。
      // conifers: migration (PreSync hook) → 新 ingestor の順序を同じ sync で保つため
      // tailscale-approval-bot: 同じ Pod の api / discord を同じコミットに揃えるため
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/giganticminecraft/seichi-timed-stats-conifers-*',
      ],
      groupName: 'seichi-timed-stats-conifers images',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/giganticminecraft/tailscale-approval-bot/*',
      ],
      groupName: 'tailscale-approval-bot images',
    },
    {
      // ノードの containerd / runc のパッチ更新はノールックで automerge する
      // (kubelet のパッチ追従は Renovate を経由せず kured の rebootCommand で完結している)。
      // マージしてもバイナリ差し替えと sentinel 作成までで、実際の再起動は
      // kured の窓 (05:00-07:00 JST) までゲートされるためマージ時刻は問わない。
      // マイナー以上の更新はこのルールに該当せず、従来どおり人がレビューしてマージする
      matchPackageNames: [
        'containerd/containerd',
        'opencontainers/runc',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      schedule: [
        'at any time',
      ],
      automerge: true,
    },
  ],
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  argocd: {
    managerFilePatterns: [
      '/^seichi-onp-k8s/manifests/seichi-kubernetes/apps/.+\\.yaml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/^helm-charts/[^/]+/templates/.+\\.yaml$/',
      '/^seichi-onp-k8s/manifests/seichi-kubernetes/apps/.+\\.yaml$/',
      '/^seichi-onp-k8s/manifests/seichi-kubernetes/app-templates/.+\\.yaml$/',
    ],
  },
  customManagers: [
    {
      // Helm values が YAML block scalar 内にあるため、組み込みの kubernetes manager
      // では検出できない kubechecks の tag を追従する。
      customType: 'regex',
      managerFilePatterns: [
        '/^seichi-onp-k8s/manifests/seichi-kubernetes/apps/root/apps[.]yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)[\\s\\S]*?tag: "(?<currentValue>[^"]+)"',
      ],
      versioningTemplate: 'semver-coerced',
    },
    {
      // hubble-observer は Cilium Agent のイメージ同梱の hubble を使うので、
      // Application の values (YAML block scalar 内) のタグを追従する。
      customType: 'regex',
      managerFilePatterns: [
        '/^seichi-onp-k8s/manifests/seichi-kubernetes/apps/cluster-wide-apps/app-of-other-apps/hubble-observer[.]yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+tag: \"?(?<currentValue>v[\\d.]+)@(?<currentDigest>sha256:[a-f0-9]+)\"?',
      ],
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^.github/workflows/build_mcserver_base_images.yaml$/',
      ],
      matchStrings: [
        '- mcserver_base_image_repo: (?<depName>[^\\s]+)\\n\\s+mcserver_base_image_tag: (?<currentValue>.*)\\n\\s+mcserver_base_image_digest: \\"(?<currentDigest>sha256:[a-f0-9]+)\\"',
      ],
      extractVersionTemplate: '^(?<version>\\d+\\.\\d+\\.\\d+)-.*',
      datasourceTemplate: 'docker',
    },
    {
      // build_itzg_images.yaml の matrix に付けた `# renovate:` コメント直後の行の値
      // (上流タグ、base image の image:tag@digest) を追従する。
      // docker の行は `eclipse-temurin:17-jre@sha256:...` のように image 名が前置されるので、
      // `@` の手前の最後の `:` までを読み飛ばして tag 部分だけを currentValue にする
      // (registry:port/ や mirror の path が付いても tag だけが残る)
      customType: 'regex',
      managerFilePatterns: [
        '/^.github/workflows/build_itzg_images.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n\\s+[A-Za-z_]+: "?(?:[^@"\\s]*:)?(?<currentValue>[^:@"\\s/]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"?',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^seichi-onp-k8s/manifests/seichi-kubernetes/apps/cluster-wide-apps/metrics-server/kustomization.yaml/',
      ],
      matchStrings: [
        'https://github.com/kubernetes-sigs/metrics-server/releases/download/v(?<currentValue>[\\d.]+)/components.yaml',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes-sigs/metrics-server',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^docker-images/mcservers/production/seichi-servers/common-image/Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: datasource=github-releases depName=giganticminecraft/SrvStopper\\nARG SRV_STOPPER_VERSION=(?<currentValue>[\\d.]+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'giganticminecraft/SrvStopper',
      versioningTemplate: 'semver',
    },
    // pbs-client イメージが焼き込む proxmox-backup-client を追従する。
    // Proxmox の apt リポジトリは公式 datasource が無いため deb datasource で直接読む。
    // (実行時 apt install をやめた代わりに、バージョン更新はここに集約される)
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^docker-images/pbs-client/Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: datasource=deb depName=proxmox-backup-client\\nARG PBS_CLIENT_VERSION=(?<currentValue>[\\d.-]+)',
      ],
      datasourceTemplate: 'deb',
      depNameTemplate: 'proxmox-backup-client',
      registryUrlTemplate: 'http://download.proxmox.com/debian/pbs-client?suite=trixie&components=main&binaryArch=amd64',
      versioningTemplate: 'deb',
    },
    // pbs-client イメージが焼き込む AWS CLI v2 を追従する
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^docker-images/pbs-client/Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: datasource=github-releases depName=aws/aws-cli\\nARG AWSCLI_VERSION=(?<currentValue>[\\d.]+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'aws/aws-cli',
      versioningTemplate: 'semver',
    },
    // ノードの containerd / runc のピン留めバージョンを更新する
    // (node-runtime-updater DaemonSet がノード上のバイナリを追従させ、kured が再起動する)
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^seichi-onp-k8s/manifests/seichi-kubernetes/apps/cluster-wide-apps/node-runtime-updater/daemonset\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n\\s+- name: [A-Z_]+_VERSION\\n\\s+value: "(?<currentValue>[\\d.]+)"',
      ],
      versioningTemplate: 'semver',
    },
    // ロビーサーバーのserver.propertiesに記載されているリソースパックのURLを更新する
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^docker-images/mcservers/production/lobby/common-minecraft-server-configs/server\\.properties$/',
      ],
      matchStrings: [
        'resource-pack=https://github\\.com/GiganticMinecraft/OriginalResourcePack/releases/download/v(?<currentValue>[\\d.]+)/seichi_tex_v[\\d.]+\\.zip',
      ],
      autoReplaceStringTemplate: 'resource-pack=https://github.com/GiganticMinecraft/OriginalResourcePack/releases/download/v{{{newValue}}}/seichi_tex_v{{{newValue}}}.zip',
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'GiganticMinecraft/OriginalResourcePack',
      // バージョン番号にパッチバージョンを含んでいないので、セマンティックバージョニングの形式だとみなす
      versioningTemplate: 'semver-coerced',
    },
  ],
  terraform: {
    enabled: true,
    managerFilePatterns: [
      '/^terraform/.*\\.tf$/',
    ],
  },
}
